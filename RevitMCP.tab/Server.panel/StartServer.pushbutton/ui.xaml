<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit MCP Server"
        Height="150" Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <DropShadowEffect x:Key="PanelShadow" BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.6"/>
    </Window.Resources>

    <Border Name="MainBorder" Margin="6" Background="#18181F" CornerRadius="12" BorderBrush="#2F2F3D" BorderThickness="1" Effect="{StaticResource PanelShadow}">
        <Grid>
            <!-- EXPANDED VIEW (Default Full Mode) -->
            <Grid Name="ExpandedView" Margin="12,10,12,10" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / Title Bar -->
                <Grid Grid.Row="0" Name="HeaderBar" Background="Transparent" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Name="LogoIcon" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Ellipse Grid.Column="1" Name="StatusIndicator" Width="8" Height="8" Fill="#2ECC71" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    
                    <StackPanel Grid.Column="2" Name="TitlePanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Revit MCP" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                        <TextBlock Name="PortBadge" Text=" :40001" FontSize="11" Foreground="#4DA8DA" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="3" Name="PinBtn" Width="24" Height="24" Background="Transparent" Foreground="#888899" BorderThickness="0" Cursor="Hand" ToolTip="Pin window (Always on Top)" Margin="0,0,2,0" Padding="0">
                        <Path Data="M4,1 L8,1 L8,4 L11,7 L11,9 L7,9 L7,13 L5,13 L5,9 L1,9 L1,7 L4,4 Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="9" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="4" Name="MinBtn" Width="24" Height="24" Background="Transparent" Foreground="#888899" BorderThickness="0" Cursor="Hand" ToolTip="Minimize to Square Panel" Margin="0,0,2,0" Padding="0">
                        <Path Data="M1,6 L9,6" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.8" Stretch="Uniform" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="5" Name="CloseButton" Width="24" Height="24" Background="Transparent" Foreground="#888899" BorderThickness="0" Cursor="Hand" ToolTip="Close" Padding="0">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Stretch="Uniform" Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Status and Live Activity Panel -->
                <Border Name="StatusCardBorder" Grid.Row="1" Background="#121217" CornerRadius="6" Padding="8,6" Margin="0,8,0,8" BorderBrush="#252533" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="StatusText" Grid.Column="0" Text="Ready for commands" FontSize="11" Foreground="#2ECC71" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Name="TimeText" Grid.Column="1" Text="" FontSize="9" Foreground="#666677" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Name="ActivityText" Text="Listening on 127.0.0.1..." FontSize="10" Foreground="#8E8E9E" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Footer Controls -->
                <Grid Grid.Row="2" Name="FooterGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Name="RequestCountText" Text="Requests: 0" FontSize="10" Foreground="#7A7A8C" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Name="SelectBtn" Content="🎯 Pick Elements" Background="#8E44AD" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Padding="8,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" ToolTip="Capture selected elements or pick elements in model">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="2" Name="ScreenshotBtn" Content="✂️ Snip &amp; Draw" Background="#2980B9" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Padding="8,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" ToolTip="Snip screen area and add visual annotations">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="3" Name="ToggleBtn" Content="Stop Server" Background="#E74C3C" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Padding="10,4" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>

            <!-- COMPACT SQUARE VIEW (Minimalist Icon Badge) -->
            <Grid Name="CompactView" Margin="10,10,10,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compact Top Row: Logo + Status Dot + Control buttons -->
                <Grid Grid.Row="0" Name="CompactHeaderBar" Background="Transparent" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Name="CompactLogoIcon" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Ellipse Grid.Column="1" Name="CompactStatusIndicator" Width="7" Height="7" Fill="#2ECC71" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    
                    <Border Grid.Column="2" Background="Transparent"/>

                    <Button Grid.Column="3" Name="CompactPinBtn" Width="20" Height="20" Background="Transparent" Foreground="#888899" BorderThickness="0" Cursor="Hand" ToolTip="Pin window (Always on Top)" Margin="0,0,2,0" Padding="0">
                        <Path Data="M4,1 L8,1 L8,4 L11,7 L11,9 L7,9 L7,13 L5,13 L5,9 L1,9 L1,7 L4,4 Z" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Stretch="Uniform" Width="8" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="4" Name="CompactMinBtn" Width="20" Height="20" Background="Transparent" Foreground="#888899" BorderThickness="0" Cursor="Hand" ToolTip="Expand to Full Panel" Margin="0,0,2,0" Padding="0">
                        <Path Data="M1,1 L9,1 L9,9 L1,9 Z M1,3.5 L9,3.5" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" Fill="Transparent" Stretch="Uniform" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="5" Name="CompactCloseBtn" Width="20" Height="20" Background="Transparent" Foreground="#888899" BorderThickness="0" Cursor="Hand" ToolTip="Close" Padding="0">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.5" Stretch="Uniform" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Compact Middle Row: Port Badge & Status Dot -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Name="CompactPortBadge" Text=":40001" FontSize="11" Foreground="#4DA8DA" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Name="CompactStatusText" Text="Ready" FontSize="9" Foreground="#2ECC71" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Compact Bottom Row: Action Icons -->
                <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Name="CompactSelectBtn" Width="34" Height="32" Background="#8E44AD" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Pick Elements in Model" Margin="0,0,5,0" Padding="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <Path Data="M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 M8,4 A4,4 0 1 0 8,12 A4,4 0 1 0 8,4 M8,7 A1,1 0 1 0 8,9 A1,1 0 1 0 8,7 M8,0 L8,3 M8,13 L8,16 M0,8 L3,8 M13,8 L16,8" Stroke="White" StrokeThickness="1.2" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="1" Name="CompactScreenshotBtn" Width="34" Height="32" Background="#2980B9" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Snip &amp; Draw" Margin="0,0,5,0" Padding="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <Path Data="M3,0 L3,13 L16,13 M0,3 L13,3 L13,16" Stroke="White" StrokeThickness="2" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="2" Name="CompactToggleBtn" Width="34" Height="32" Background="#E74C3C" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="Stop / Start MCP Server" Padding="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <Rectangle Width="10" Height="10" Fill="White" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
