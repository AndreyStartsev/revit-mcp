<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit MCP Server"
        Height="150" Width="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <DropShadowEffect x:Key="PanelShadow" BlurRadius="16" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.6"/>
    </Window.Resources>

    <Border Name="MainBorder" Margin="6" Background="#18181F" CornerRadius="12" BorderBrush="#2F2F3D" BorderThickness="1" Effect="{StaticResource PanelShadow}">
        <Grid>
            <!-- EXPANDED VIEW (Default Full Mode) -->
            <Grid Name="ExpandedView" Margin="12,10,12,10" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / Title Bar -->
                <Grid Grid.Row="0" Name="HeaderBar" Background="Transparent" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Name="LogoIcon" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Ellipse Grid.Column="1" Name="StatusIndicator" Width="8" Height="8" Fill="#2ECC71" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    
                    <StackPanel Grid.Column="2" Name="TitlePanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Revit MCP" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                        <TextBlock Name="PortBadge" Text=" :40001" FontSize="11" Foreground="#4DA8DA" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="3" Name="PinBtn" Content="📌" Width="22" Height="22" Background="Transparent" Foreground="#888899" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="Pin window (Always on Top)" Margin="0,0,2,0"/>
                    <Button Grid.Column="4" Name="MinBtn" Content="🗕" Width="22" Height="22" Background="Transparent" Foreground="#888899" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="Minimize to Square Panel" Margin="0,0,2,0"/>
                    <Button Grid.Column="5" Name="CloseButton" Content="✕" Width="20" Height="20" Background="Transparent" Foreground="#888899" BorderThickness="0" FontWeight="Bold" FontSize="11" Cursor="Hand"/>
                </Grid>

                <!-- Status and Live Activity Panel -->
                <Border Name="StatusCardBorder" Grid.Row="1" Background="#121217" CornerRadius="6" Padding="8,6" Margin="0,8,0,8" BorderBrush="#252533" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Name="StatusText" Grid.Column="0" Text="Ready for commands" FontSize="11" Foreground="#2ECC71" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Name="TimeText" Grid.Column="1" Text="" FontSize="9" Foreground="#666677" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Name="ActivityText" Text="Listening on 127.0.0.1..." FontSize="10" Foreground="#8E8E9E" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Footer Controls -->
                <Grid Grid.Row="2" Name="FooterGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Name="RequestCountText" Text="Requests: 0" FontSize="10" Foreground="#7A7A8C" VerticalAlignment="Center"/>

                    <Button Grid.Column="1" Name="SelectBtn" Content="🎯 Pick Elements" Background="#8E44AD" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Padding="8,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" ToolTip="Capture selected elements or pick elements in model">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="2" Name="ScreenshotBtn" Content="✂️ Snip &amp; Draw" Background="#2980B9" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Padding="8,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" ToolTip="Snip screen area and add visual annotations">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="3" Name="ToggleBtn" Content="Stop Server" Background="#E74C3C" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" Padding="10,4" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>

            <!-- COMPACT SQUARE VIEW (Minimalist Icon Badge) -->
            <Grid Name="CompactView" Margin="8,7,8,7" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Compact Top Row: Logo + Status Dot + Control buttons -->
                <Grid Grid.Row="0" Name="CompactHeaderBar" Background="Transparent" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Name="CompactLogoIcon" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Ellipse Grid.Column="1" Name="CompactStatusIndicator" Width="7" Height="7" Fill="#2ECC71" VerticalAlignment="Center" Margin="0,0,2,0"/>
                    
                    <Border Grid.Column="2" Background="Transparent"/>

                    <Button Grid.Column="3" Name="CompactPinBtn" Content="📌" Width="18" Height="20" Background="Transparent" Foreground="#888899" BorderThickness="0" FontSize="10" Cursor="Hand" ToolTip="Pin window (Always on Top)"/>
                    <Button Grid.Column="4" Name="CompactMinBtn" Content="⤢" Width="18" Height="20" Background="Transparent" Foreground="#888899" BorderThickness="0" FontSize="10" Cursor="Hand" ToolTip="Expand to Full Panel"/>
                    <Button Grid.Column="5" Name="CompactCloseBtn" Content="✕" Width="18" Height="20" Background="Transparent" Foreground="#888899" BorderThickness="0" FontWeight="Bold" FontSize="10" Cursor="Hand"/>
                </Grid>

                <!-- Compact Bottom Row: Action Icons -->
                <Grid Grid.Row="1" Margin="0,7,0,0" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Name="CompactSelectBtn" Content="🎯" Width="24" Height="24" Background="#8E44AD" Foreground="#FFFFFF" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="Pick Elements in Model" Margin="0,0,3,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                    <Button Grid.Column="1" Name="CompactScreenshotBtn" Content="✂️" Width="24" Height="24" Background="#2980B9" Foreground="#FFFFFF" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="Snip &amp; Draw" Margin="0,0,3,0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                    <Button Grid.Column="2" Name="CompactToggleBtn" Content="⏹" Width="24" Height="24" Background="#E74C3C" Foreground="#FFFFFF" BorderThickness="0" FontSize="11" Cursor="Hand" ToolTip="Stop / Start MCP Server">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
